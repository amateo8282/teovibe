<div class="max-w-[820px] mx-auto px-5 pt-12 pb-14">
  <%# 뒤로가기 %>
  <div class="mb-8">
    <%= link_to skill_packs_path, class: "inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-tv-gray hover:text-tv-orange transition-colors" do %>
      <span aria-hidden="true">←</span> 스킬팩 목록
    <% end %>
  </div>

  <%# 에디토리얼 헤더 %>
  <header class="mb-8">
    <p class="tv-eyebrow mb-5"><%= @skill_pack.category_name %></p>
    <h1 class="text-[clamp(28px,4.6vw,48px)] font-black leading-[1.08] tracking-[-0.04em] mb-5"><%= @skill_pack.title %></h1>
    <div class="flex items-center gap-3 font-mono text-[11px] tracking-wider uppercase text-tv-gray flex-wrap">
      <span><%= @skill_pack.created_at.strftime("%Y.%m.%d") %></span>
      <span class="text-tv-light-gray">/</span>
      <span>⬇ <%= @skill_pack.downloads_count %>회 다운로드</span>
    </div>
  </header>

  <%# 썸네일 %>
  <% if @skill_pack.thumbnail.attached? %>
    <%= image_tag @skill_pack.thumbnail, class: "w-full rounded-card border border-tv-hairline-soft mb-10", style: "max-height:420px;object-fit:cover" %>
  <% end %>

  <div class="tv-article prose max-w-none text-tv-dark leading-relaxed mb-10">
    <%= simple_format(@skill_pack.description) %>
  </div>

  <%# 다운로드 %>
  <% if @skill_pack.file.attached? %>
    <%= link_to download_skill_pack_path(@skill_pack), class: "tv-btn tv-btn--gold" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      무료 다운로드
    <% end %>
  <% else %>
    <span class="tv-btn tv-btn--ghost opacity-70 cursor-default">파일 준비 중</span>
  <% end %>
</div>
