<noscript>
  <div style="padding:24px 48px;font-size:15px;background:#fff;border-top:1px solid rgba(0,0,0,.1)">
    이 페이지의 강의 목록은 JavaScript로 렌더링됩니다. <code>manifest.json</code>을 직접 확인하거나 <code>slides/</code> 폴더의 HTML 파일을 열어주세요.
  </div>
</noscript>

<script>
/* ════════════════════════════════════════════
   상태
   ════════════════════════════════════════════ */
let DECKS = [];
let currentFilter = 'all';
let UNLOCKED = new Set();    /* 잠금 해제된 슬라이드 파일명 집합 (/api/me) */
let CHECKOUT = {};           /* 데크별 Polar 체크아웃 링크 {파일명: url} (/api/me) */
const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
const finePointer  = matchMedia('(pointer: fine)').matches;

const categoryOf = d => (d.tags || []).includes('심화') ? 'adv' : 'basic';

/* ════════════════════════════════════════════
   스크롤 리빌
   ════════════════════════════════════════════ */
const io = new IntersectionObserver(entries => {
  for (const e of entries) {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }
}, { threshold: 0.12, rootMargin: '0px 0px -4% 0px' });

function observeReveals(root = document) {
  root.querySelectorAll('.reveal:not(.in)').forEach(el => io.observe(el));
}

/* ════════════════════════════════════════════
   헤더 + 프로그레스 바
   ════════════════════════════════════════════ */
const progressBar = document.getElementById('progress-bar');
let ticking = false;
function onScroll() {
  if (ticking) return;
  ticking = true;
  requestAnimationFrame(() => {
    const y = scrollY;
    document.body.toggleAttribute('data-scrolled', y > 24);
    const max = document.documentElement.scrollHeight - innerHeight;
    progressBar.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
    ticking = false;
  });
}
addEventListener('scroll', onScroll, { passive: true });
onScroll();

/* ════════════════════════════════════════════
   카운트업
   ════════════════════════════════════════════ */
function countUp(el, target, duration = 1400) {
  if (reduceMotion || target === 0) { el.textContent = target; return; }
  const t0 = performance.now();
  (function tick(now) {
    const p = Math.min((now - t0) / duration, 1);
    el.textContent = Math.round(target * (1 - Math.pow(1 - p, 4)));
    if (p < 1) requestAnimationFrame(tick);
  })(t0);
}

/* duration 문자열 → 분: "90분 × 2회"=180, "3시간"=180 */
function toMinutes(str) {
  if (!str) return 0;
  let m = 0;
  const h  = str.match(/(\d+(?:\.\d+)?)\s*시간/);
  const mm = str.match(/(\d+)\s*분/);
  if (h)  m += parseFloat(h[1]) * 60;
  if (mm) m += parseInt(mm[1], 10);
  const x = str.match(/[×x]\s*(\d+)/);
  if (x) m *= parseInt(x[1], 10);
  return m;
}

function buildStats(decks) {
  const slides = decks.reduce((s, d) => s + (d.slides || 0), 0);
  const hours  = Math.floor(decks.reduce((s, d) => s + toMinutes(d.duration), 0) / 60);
  countUp(document.getElementById('stat-decks'), decks.length, 1000);
  countUp(document.getElementById('stat-slides'), slides, 1500);
  countUp(document.getElementById('stat-hours'), hours, 1300);

  const latest = decks.map(d => d.date).filter(Boolean).sort().pop();
  if (latest) {
    document.getElementById('hero-updated').textContent =
      `Last update — ${latest.replaceAll('-', '.')}`;
  }
  document.getElementById('header-count').textContent =
    `${String(decks.length).padStart(2, '0')} DECKS`;
}

/* ════════════════════════════════════════════
   마키
   ════════════════════════════════════════════ */
const MARQUEE_TOPICS = [
  'Claude Code', 'Cursor IDE', 'Supabase', 'GitHub Actions', 'Agent SDK',
  'Entity Modeling', 'CI · CD', 'Prompt → Product', 'Vibe Coding', 'Ship It'
];
function buildMarquee() {
  const seq = document.getElementById('marquee-seq');
  seq.innerHTML = MARQUEE_TOPICS.map((t, i) =>
    `<span class="marquee-item">${t}</span><span class="marquee-star">${i % 2 ? '✦' : '✶'}</span>`
  ).join('');
  const track = document.getElementById('marquee-track');
  const clone = seq.cloneNode(true);
  clone.setAttribute('aria-hidden', 'true');
  track.appendChild(clone);
}

/* ════════════════════════════════════════════
   덱 카드 렌더링
   ════════════════════════════════════════════ */
function renderCard(deck, i, originalIdx) {
  const no    = String(originalIdx + 1).padStart(2, '0');
  const week  = (deck.tags && deck.tags[0]) || 'Session';
  const p     = 18 + (originalIdx * 17) % 58;   /* 미니 진행 바 길이 — 덱마다 다르게 */
  const thumb = deck.thumb || 'thumb--dark';

  const fname  = (deck.file || '').split('/').pop();
  const buyUrl = CHECKOUT[fname] || '';
  const locked = !!deck.paid && !UNLOCKED.has(fname);   /* 유료 + 미구매 = 잠김 */
  const href   = '/courses/' + deck.slug;
  const target = locked ? '_self' : '_blank';
  const aria   = locked ? `${deck.title} — 심화 패키지 구매` : `${deck.title} 슬라이드 열기`;
  const cta    = locked ? '구매하고 열람' : '발표 열기';
  const ctaIcon = locked
    ? `<span class="arrow-circle"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 7V5a3 3 0 1 1 6 0v2m-7 0h8v6H4V7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span>`
    : `<span class="arrow-circle"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>`;

  return `
  <a class="deck-card reveal${locked ? ' deck-card--locked' : ''}" style="--d:${Math.min(i * 0.07, 0.42)}s" href="${href}" target="${target}" rel="noopener" aria-label="${aria}">
    <div class="thumb ${thumb}" style="--p:${p}%">
      ${locked ? `<span class="lock-badge">🔒 ₩${(deck.price || 0).toLocaleString()}</span>` : ''}
      <div class="thumb-top">
        <span>Teo Vibe Edu</span>
        <span class="thumb-no">N°${no}</span>
      </div>
      <div class="thumb-mid">
        <span class="thumb-emoji" aria-hidden="true">${deck.emoji || '📑'}</span>
        <span class="thumb-title">${deck.title}</span>
      </div>
      <div class="thumb-bottom">
        <span class="thumb-week">${week}</span>
        <span class="thumb-slides">${deck.slides || '–'} slides</span>
      </div>
    </div>
    <div class="deck-body">
      <p class="deck-desc">${deck.desc || ''}</p>
      <div class="deck-meta">
        <span class="deck-duration">⏱ ${deck.duration || '—'}</span>
        <span class="deck-open">${cta}
          ${ctaIcon}
        </span>
      </div>
    </div>
  </a>`;
}

function renderGrid(filter) {
  const grid = document.getElementById('deck-grid');
  const list = DECKS
    .map((d, idx) => ({ d, idx }))
    .filter(({ d }) => filter === 'all' || categoryOf(d) === filter);

  if (!list.length) {
    grid.innerHTML = `
      <div class="state-card">
        <span class="big">Empty.</span>
        <p class="msg">아직 이 분류의 강의가 없어요.<br>슬라이드 덱이 추가되면 자동으로 표시됩니다.</p>
      </div>`;
    return;
  }
  grid.innerHTML = list.map(({ d, idx }, i) => renderCard(d, i, idx)).join('');
  observeReveals(grid);
  if (finePointer && !reduceMotion) bindTilt(grid);
}

/* ════════════════════════════════════════════
   필터
   ════════════════════════════════════════════ */
function bindFilters() {
  const counts = {
    all:   DECKS.length,
    basic: DECKS.filter(d => categoryOf(d) === 'basic').length,
    adv:   DECKS.filter(d => categoryOf(d) === 'adv').length,
  };
  document.querySelectorAll('[data-n]').forEach(el => {
    el.textContent = counts[el.dataset.n] ?? 0;
  });
  document.getElementById('filters').addEventListener('click', e => {
    const btn = e.target.closest('.filter-btn');
    if (!btn || btn.dataset.filter === currentFilter) return;
    currentFilter = btn.dataset.filter;
    document.querySelectorAll('.filter-btn').forEach(b =>
      b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
    renderGrid(currentFilter);
  });
}

/* ════════════════════════════════════════════
   카드 틸트 (데스크톱 전용, 미세하게)
   ════════════════════════════════════════════ */
function bindTilt(grid) {
  grid.querySelectorAll('.deck-card').forEach(card => {
    card.addEventListener('pointermove', e => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width  - 0.5;
      const py = (e.clientY - r.top)  / r.height - 0.5;
      card.style.setProperty('--ry', `${(px * 4).toFixed(2)}deg`);
      card.style.setProperty('--rx', `${(-py * 4).toFixed(2)}deg`);
    });
    card.addEventListener('pointerleave', () => {
      card.style.setProperty('--ry', '0deg');
      card.style.setProperty('--rx', '0deg');
    });
  });
}

/* ════════════════════════════════════════════
   init
   ════════════════════════════════════════════ */
function reflectEntitlement() {
  const link = document.getElementById('unlock-link');
  if (!link) return;
  link.href = '/unlock';
  link.textContent = UNLOCKED.size ? '🔓 잠금 해제' : '🔒 잠금 해제';
}

async function init() {
  buildMarquee();
  document.getElementById('year').textContent = new Date().getFullYear();

  /* Rails /courses.json — 강의 데이터 + 잠금상태를 한 번에 */
  try {
    const res = await fetch('/courses.json', { headers: { 'Accept': 'application/json' } });
    if (!res.ok) throw new Error(res.status);
    const data = await res.json();
    DECKS    = data.decks || [];
    UNLOCKED = new Set(data.unlocked || []);
    CHECKOUT = data.checkout || {};
    reflectEntitlement();
    buildStats(DECKS);
    bindFilters();
    renderGrid('all');
  } catch (err) {
    document.getElementById('deck-grid').innerHTML = `
      <div class="state-card">
        <span class="big">Oops.</span>
        <p class="msg">강의 목록을 불러오지 못했어요.<br>새로고침해 주세요.</p>
      </div>`;
  }
  observeReveals();
  requestAnimationFrame(() => document.body.classList.add('loaded'));
}
init();
</script>
