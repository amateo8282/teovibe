<% content_for :title, "#{@course.title} · 구매" %>
<div class="wrap">
  <div class="buybox">
    <p class="hero-label">🔒 Premium · <%= @course.tag %></p>
    <h1><%= @course.title %></h1>
    <p class="desc"><%= @course.description %></p>
    <div class="price">₩<%= number_with_delimiter(@course.price) %></div>

    <%# 포트원(PortOne) 결제 — 한국 카드·간편결제(해외결제/플러그인 이슈 없음). .env 채워지면 활성. %>
    <% if current_user && PortoneService.configured? %>
      <%# 이니시스(card) PC 결제는 customer.fullName·email·phoneNumber 필수 — 누락 시 issue-prepare 400. %>
      <% payer_name = current_user.nickname.presence || current_user.email_address.split("@").first %>
      <label class="muted" for="portone-phone" style="display:block;margin-bottom:6px">휴대폰 번호 (카드 결제 시 필수)</label>
      <input id="portone-phone" type="tel" inputmode="numeric" autocomplete="tel"
             placeholder="01012345678"
             style="width:100%;margin-bottom:12px;padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,.15)">
      <button id="portone-pay" class="btn btn--gold"
              data-checkout-url="<%= course_checkout_path(@course.slug) %>"
              data-payer-name="<%= payer_name %>"
              data-payer-email="<%= current_user.email_address %>">
        ₩<%= number_with_delimiter(@course.price) %> 결제하기 (카드·간편결제) →
      </button>
      <p class="muted" id="portone-msg" style="margin-top:12px"></p>
      <script src="https://cdn.portone.io/v2/browser-sdk.js"></script>
      <script>
      (function () {
        var btn = document.getElementById('portone-pay');
        var msg = document.getElementById('portone-msg');
        var csrf = document.querySelector('meta[name="csrf-token"]').content;
        function post(url) {
          return fetch(url, { method: 'POST', headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' } }).then(function (r) { return r.json(); });
        }
        btn.addEventListener('click', async function () {
          btn.disabled = true; msg.textContent = '결제창을 여는 중…';
          try {
            var cfg = await post(btn.dataset.checkoutUrl);
            if (cfg.already) { location.href = cfg.redirect; return; }
            if (!cfg.payment_id) { msg.textContent = cfg.error || '결제를 시작할 수 없습니다.'; btn.disabled = false; return; }
            var phone = (document.getElementById('portone-phone').value || '').replace(/[^0-9]/g, '');
            if (phone.length < 10) { msg.textContent = '휴대폰 번호를 정확히 입력해 주세요 (카드 결제 필수).'; btn.disabled = false; return; }
            var res = await PortOne.requestPayment({
              storeId: cfg.store_id, channelKey: cfg.channel_key,
              paymentId: cfg.payment_id, orderName: cfg.order_name,
              totalAmount: cfg.amount, currency: cfg.currency, payMethod: 'CARD',
              customer: {
                fullName: btn.dataset.payerName,
                email: btn.dataset.payerEmail,
                phoneNumber: phone
              }
            });
            if (res && res.code != null) { msg.textContent = '결제 취소/실패: ' + (res.message || res.code); btn.disabled = false; return; }
            msg.textContent = '결제 확인 중…';
            var out = await post('/payments/' + encodeURIComponent(cfg.payment_id) + '/complete');
            if (out.ok) { location.href = out.redirect; } else { msg.textContent = out.error || '검증 실패'; btn.disabled = false; }
          } catch (e) { msg.textContent = '오류: ' + (e && e.message ? e.message : e); btn.disabled = false; }
        });
      })();
      </script>
      <div class="divider"></div>
      <p class="muted" style="margin-bottom:8px">해외 카드로 결제하시나요?</p>
    <% end %>

    <% if @course.checkout_url.present? %>
      <% buy_url = current_user ? "#{@course.checkout_url}?customer_email=#{CGI.escape(current_user.email_address)}" : @course.checkout_url %>
      <a class="btn btn--gold" href="<%= buy_url %>" target="_blank" rel="noopener">
        ₩<%= number_with_delimiter(@course.price) %> 구매하기 →
      </a>
      <% if current_user %>
        <p class="muted" style="margin-top:12px">로그인 계정(<%= current_user.email_address %>)으로 구매하면 결제 후 자동으로 이 강의가 열립니다.</p>
      <% end %>
    <% else %>
      <p class="muted">결제 링크 준비 중입니다.</p>
    <% end %>

    <div class="divider"></div>

    <% if current_user %>
      <p class="muted" style="margin-bottom:12px">이미 구매하셨나요? 받으신 <strong>라이선스 키</strong>를 입력하면 이 계정에 강의가 연결됩니다.</p>
      <%= form_with url: unlock_courses_path, method: :post, class: "keyform" do |f| %>
        <%= f.text_field :key, placeholder: "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX", autocomplete: "off" %>
        <%= f.submit "잠금 해제", class: "btn btn--ghost" %>
      <% end %>
    <% else %>
      <p class="muted">이미 구매하셨다면 <a href="<%= new_session_path %>">로그인</a> 후 라이선스 키를 입력해 강의를 계정에 연결하세요. 계정이 있으면 키 없이도 다음 결제부터 자동으로 열립니다.</p>
    <% end %>
  </div>
</div>
