<%# 구조화 데이터 JSON-LD (Article + BreadcrumbList) %>
<% content_for :head do %>
  <script type="application/ld+json"><%= article_json_ld(@post) %></script>
  <script type="application/ld+json"><%= breadcrumb_json_ld([
    { name: "홈", url: root_url },
    { name: @post.category_name, url: category_posts_url(category_slug: @post.category&.slug) },
    { name: @post.title }
  ]) %></script>
<% end %>

<article class="max-w-[820px] mx-auto px-5 pt-12 pb-10">
  <%= render "shared/breadcrumb", items: [
    { name: "홈", path: root_path },
    { name: @post.category_name, path: category_posts_path(category_slug: @post.category&.slug) },
    { name: @post.title }
  ] %>

  <%# 에디토리얼 아티클 헤더 %>
  <header class="mb-10">
    <p class="tv-eyebrow mb-5"><%= @post.category_name %></p>
    <h1 class="text-[clamp(30px,5vw,54px)] font-black leading-[1.07] tracking-[-0.04em] mb-6"><%= @post.title %></h1>
    <div class="flex items-center gap-3 font-mono text-[11px] tracking-wider uppercase text-tv-gray flex-wrap">
      <span class="font-semibold text-tv-black"><%= @post.user.nickname %></span>
      <span class="text-tv-light-gray">/</span>
      <span><%= l(@post.created_at, format: :long) rescue @post.created_at.strftime("%Y.%m.%d") %></span>
      <span class="text-tv-light-gray">/</span>
      <span>조회 <%= @post.views_count %></span>
    </div>
  </header>

  <% body_html, toc = post_body_with_toc(@post.body) %>
  <% if toc.size >= 2 %>
    <nav class="mb-10 rounded-2xl border border-tv-hairline bg-tv-cream-light px-6 py-5" aria-label="목차">
      <p class="font-mono text-[11px] font-semibold tracking-[2px] uppercase text-tv-orange mb-3">목차 · Index</p>
      <ul class="space-y-1.5 text-sm">
        <% toc.each do |e| %>
          <li class="<%= "ml-4" if e[:level] == 3 %>">
            <%= link_to e[:text], "##{e[:id]}", class: "text-tv-gray hover:text-tv-orange transition-colors" %>
          </li>
        <% end %>
      </ul>
    </nav>
  <% end %>

  <div class="tv-article prose prose-lg max-w-none mb-12">
    <%= body_html %>
  </div>

  <%# 좋아요 + 액션 %>
  <div class="flex items-center justify-between border-t border-b border-tv-hairline py-5 mb-12">
    <div id="<%= dom_id(@post, :like) %>">
      <%= render "likes/button", likeable: @post %>
    </div>
    <% if @post.user == Current.user || Current.user&.admin? %>
      <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-wide">
        <%= link_to "수정", edit_post_path(@post), class: "text-tv-gray hover:text-tv-black" %>
        <%= button_to "삭제", post_path(@post), method: :delete,
          data: { turbo_confirm: "정말 삭제하시겠습니까?" },
          class: "text-red-500 hover:text-red-700" %>
      </div>
    <% end %>
  </div>

  <%# 댓글 섹션 %>
  <section id="comments">
    <p class="tv-eyebrow mb-2">Comments</p>
    <h2 class="text-2xl font-black mb-6 tracking-tight">댓글 <span class="font-mono text-tv-gold text-xl align-middle"><%= @post.comments_count %></span></h2>

    <% if Current.user %>
      <%= render "comments/form", post: @post %>
    <% else %>
      <p class="text-tv-gray mb-6"><%= link_to "로그인", new_session_path, class: "text-tv-orange font-bold" %>하고 댓글을 남겨보세요.</p>
    <% end %>

    <div id="comments-list" class="space-y-6">
      <% @comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
    </div>
  </section>
</article>
